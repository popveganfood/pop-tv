# Copie para .env (NUNCA versione o .env). Em produção configure no painel do Railway.
NODE_ENV=development
PORT=3000
# Supabase: Project Settings → Database → Connection string (Session pooler, porta 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pop_tv
# true quando o Postgres exige SSL (Supabase): true
DATABASE_SSL=false
# Endereço público do painel (usado em links e cookies seguros)
PUBLIC_URL=http://localhost:3000
# Segredo longo e aleatório (openssl rand -hex 32) — assina URLs locais
APP_SECRET=troque-isto-por-um-segredo-aleatorio
# Admin inicial: criado só se ainda não existir nenhum usuário
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Armazenamento: r2 (produção) | local (somente desenvolvimento/testes)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
# Cloudflare R2 (R2 → Manage API tokens → Object Read & Write, apenas no bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pop-tv-media
# Limites de upload (MB)
MAX_IMAGE_MB=25
MAX_VIDEO_MB=500
