{
  "name": "pop-tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POP TV — gestão remota de telas do POP Vegan Food",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/src/index.ts",
    "migrate": "node server/src/db.ts migrate",
    "create-admin": "node server/src/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test --test-concurrency=1 server/test/*.test.ts",
    "e2e": "node e2e/acceptance.mjs",
    "e2e:panel": "node e2e/panel.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "1.56",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
